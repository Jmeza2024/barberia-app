# Copia este archivo como .env.local y llena los valores de tu proyecto de Supabase
# (Supabase > Project Settings > API). NUNCA subas .env.local a GitHub.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon

# Clave secreta de administrador (Supabase > Project Settings > API > service_role).
# Solo se usa en el servidor para crear las cuentas de los barberos.
# Es como la llave maestra: NUNCA la compartas ni la pongas en código que vea el navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# --- Etapa 8 (opcional): WhatsApp automático ---------------------------
# Sin estas claves la app funciona igual, con botones para enviar a mano.
# Cómo conseguirlas: docs/aprende-etapa-8.md. Nunca las pongas en el código.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Una clave inventada por ti (larga, al azar). Vercel la usa para el envío diario.
CRON_SECRET=
# La dirección pública de la app, para los enlaces de los mensajes.
SITIO_URL=https://tu-app.vercel.app
